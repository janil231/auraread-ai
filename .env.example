# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional. Only needed to pin one specific model.
#
# Leave this UNSET unless you are debugging. When it is unset the API walks a
# verified fallback chain and survives transient free-tier outages on its own.
#
# Verified working on a freshly created key (Oct 2026):
#   gemini-3.5-flash-lite   fastest (1-18s, highest variance)
#   gemini-3.1-flash-lite   fast
#   gemini-3.5-flash        slowest but most accurate
#
# Do NOT pin these on a new Google AI Studio account - they return 404:
#   gemini-1.5-flash, gemini-1.5-flash-latest   (entire 1.5 family is retired)
#   gemini-2.5-flash, gemini-2.5-flash-lite     ("no longer available to new users")
#   gemini-flash-latest, 3.6-flash, 3.7-flash   (frequent 503 "high demand")
#
# GEMINI_MODEL=gemini-3.5-flash-lite